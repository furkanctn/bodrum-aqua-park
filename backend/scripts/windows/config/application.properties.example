# config\application.properties — JAR ve BodrumAquaPark.bat ile AYNI klasorde (config alt klasoru)
# Ilk calistirmada BAT bu dosyayi example'dan olusturabilir; sizin dosyaniz varsa dokunmaz.

# PostgreSQL — DATA-SERVER (kasa PC: uygulama 127.0.0.1:8081, veri sunucuda)
spring.datasource.url=jdbc:postgresql://10.100.172.9:5433/bodrum_aqua_park
spring.datasource.username=postgres
spring.datasource.password=DEGISTIR

# Tum kasalarda ayni olmali (en az 32 karakter)
app.jwt.secret=DEGISTIR-en-az-32-karakter-gizli-anahtar

# Login ekraninda gorunen surum (bos birakilirsa JAR icindeki app.version kullanilir)
# app.version=1.2.0.1

# Turnike (istege bagli — bos birakilabilir)
app.access.bootstrap.device-id=turnike_1
app.access.bootstrap.device-token=turnike-secret-123
